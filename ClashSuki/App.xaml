<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ClashSuki.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClashSuki"
    xmlns:viewModels="using:ClashSuki.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <viewModels:BoolToVisibilityConverter x:Key="BoolToVis" />
            <viewModels:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <viewModels:InverseBoolConverter x:Key="InverseBool" />
            <viewModels:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVis" />
            <viewModels:NumberZeroToVisibilityConverter x:Key="NumberZeroToVis" />
            <viewModels:NumberZeroToVisibilityConverter x:Key="NumberNotZeroToVis" Invert="True" />
            <viewModels:NullToVisibilityConverter x:Key="NullToVis" />
            <viewModels:ProcessIconElementConverter x:Key="ProcessIconElement" />
            <viewModels:DelayBrushConverter x:Key="DelayBrush" />
            <viewModels:LogLevelBrushConverter x:Key="LogLevelBrush" />
            <FontFamily x:Key="EmojiFontFamily">ms-appx:///Assets/Fonts/TwemojiMozilla.ttf#Twemoji Mozilla</FontFamily>
            <Thickness x:Key="PagePadding">32,24,32,32</Thickness>
            <Thickness x:Key="CardPadding">16</Thickness>
            <x:Double x:Key="PageSpacing">16</x:Double>
            <!-- WinUI Gallery PageHeader 图标按钮：SubtleButtonStyle + FontSize 14 + 16px 视口 -->
            <x:Double x:Key="IconActionButtonIconFontSize">14</x:Double>
            <x:Double x:Key="IconActionButtonViewportSize">16</x:Double>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="MutedCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="ListItemTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="EmptyStateIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Opacity" Value="0.75" />
            </Style>

            <Style x:Key="EmptyStateDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedCaptionTextStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="EmptyStateHostStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="220" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="EmptyStatePanelStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedCaptionTextStyle}">
                <Setter Property="Opacity" Value="0.55" />
            </Style>

            <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- 实时列表：关闭 WinUI 默认的插入/删除/重排动画，避免新增条目时整表闪烁 -->
            <Style x:Key="LiveListViewStyle" TargetType="ListView">
                <Setter Property="ItemContainerTransitions">
                    <Setter.Value>
                        <TransitionCollection />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LiveListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
