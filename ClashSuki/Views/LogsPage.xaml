<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSuki.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ClashSuki.ViewModels"
    xmlns:ui="using:ClashSuki.Controls"
    NavigationCacheMode="Enabled">
    <Grid x:Name="PageRoot" Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource PageSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="日志" Style="{StaticResource PageTitleStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="LogSourceSelector" SelectionChanged="LogSourceSelector_SelectionChanged" VerticalAlignment="Center">
                <SelectorBarItem x:Name="AppLogsItem" Text="程序日志" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="MihomoLogsItem" Text="Mihomo 日志">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBox Width="200"
                         PlaceholderText="搜索日志"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{Binding LevelFilterIndex, Mode=TwoWay}"
                          Width="100"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="DEBUG" />
                    <ComboBoxItem Content="INFO" />
                    <ComboBoxItem Content="WARN" />
                    <ComboBoxItem Content="ERROR" />
                </ComboBox>
                <ui:IconActionButton Command="{Binding ToggleAutoRefreshCommand}" Glyph="{Binding AutoRefreshGlyph}" VerticalAlignment="Center" ToolTipService.ToolTip="切换日志自动刷新" />
                <ui:IconActionButton Command="{Binding ClearLogsCommand}" Glyph="&#xE74D;" VerticalAlignment="Center" ToolTipService.ToolTip="清空日志" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid Style="{StaticResource EmptyStateHostStyle}"
                      Visibility="{Binding CurrentFilteredLogCount, Converter={StaticResource NumberZeroToVis}}">
                    <StackPanel Style="{StaticResource EmptyStatePanelStyle}">
                        <FontIcon Glyph="&#xE8BD;" Style="{StaticResource EmptyStateIconStyle}" />
                        <TextBlock Text="{Binding EmptyLogText}" Style="{StaticResource EmptyStateTitleStyle}" />
                    </StackPanel>
                </Grid>
                <ListView ItemsSource="{Binding CurrentFilteredLogs}"
                          Style="{StaticResource LiveListViewStyle}"
                          Visibility="{Binding CurrentFilteredLogCount, Converter={StaticResource NumberNotZeroToVis}}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource LiveListViewItemStyle}" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogItemViewModel">
                            <Border Padding="8,6"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    Tapped="LogItem_Tapped"
                                    ToolTipService.ToolTip="点击复制这一行日志">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind TimeText}"
                                               Style="{StaticResource MutedCaptionTextStyle}"
                                               VerticalAlignment="Top" />
                                    <Border Grid.Column="1"
                                            Background="{x:Bind Level, Converter={StaticResource LogLevelBrush}}"
                                            CornerRadius="4"
                                            Padding="4,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind Level}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Source}"
                                               Style="{StaticResource MutedCaptionTextStyle}"
                                               VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Message}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource BodyTextStyle}" />
                                    <ui:IconActionButton Grid.Column="4"
                                                         Glyph="&#xE946;"
                                                         Visibility="{x:Bind HasDetails, Converter={StaticResource BoolToVis}}"
                                                         Click="LogDetails_Click"
                                                         Tapped="LogDetailsButton_Tapped"
                                                         ToolTipService.ToolTip="查看异常详情" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
