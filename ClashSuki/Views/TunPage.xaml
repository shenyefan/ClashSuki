<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSuki.Views.TunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClashSuki.Controls"
    NavigationCacheMode="Enabled">
    <Page.Resources>
        <Style x:Key="TunTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel Padding="{StaticResource PagePadding}"
                    Spacing="{StaticResource PageSpacing}"
                    HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="虚拟网卡" Style="{StaticResource PageTitleStyle}" />
                <ui:IconActionButton Grid.Column="1" Click="Reset_Click" Glyph="&#xE72C;" IsLoading="{Binding ResetAndSaveCommand.IsRunning}" VerticalAlignment="Center" ToolTipService.ToolTip="恢复默认值" />
                <ui:IconActionButton Grid.Column="2" Command="{Binding SaveCommand}" Glyph="&#xE74E;" VerticalAlignment="Center" ToolTipService.ToolTip="保存到配置" />
            </Grid>

            <TextBlock Text="基础设置" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="启用虚拟网卡" Description="{Binding Runtime.TunServiceStatusText}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="安装服务"
                                Command="{Binding InstallPortableServiceCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{Binding Runtime.ShowTunServiceInstallAction, Converter={StaticResource BoolToVis}}" />
                        <ui:IconActionButton Click="RepairService_Click" Glyph="&#xE72C;" IsLoading="{Binding RepairServiceCommand.IsRunning}" Visibility="{Binding Runtime.ShowTunServiceRepairAction, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="修复服务" />
                        <ui:IconActionButton Click="StopService_Click" Glyph="&#xE71A;" IsLoading="{Binding StopServiceCommand.IsRunning}" Visibility="{Binding Runtime.ShowTunServiceStopAction, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="停止服务" />
                        <ToggleSwitch MinWidth="0"
                                      Width="48"
                                      OnContent=""
                                      OffContent=""
                                      IsOn="{Binding Runtime.IsTunEnabled, Mode=OneWay}"
                                      Toggled="Tun_Toggled"
                                      HorizontalAlignment="Right"
                                      Visibility="{Binding Runtime.IsTunToggleAvailable, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="防火墙规则"
                                       Description="{Binding Runtime.TunFirewallDescription}"
                                       IsEnabled="{Binding Runtime.IsTunToggleAvailable}">
                    <ui:IconActionButton Command="{Binding SetupFirewallCommand}" Glyph="&#xE72C;" ToolTipService.ToolTip="重建防火墙规则" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="协议栈" Description="gVisor 兼容性更好，System 性能更高">
                    <ComboBox SelectedIndex="{Binding StackIndex, Mode=TwoWay}" MinWidth="136" HorizontalAlignment="Right">
                        <ComboBoxItem Content="gVisor" />
                        <ComboBoxItem Content="Mixed" />
                        <ComboBoxItem Content="System" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard Header="自动路由" Description="自动配置系统路由表">
                    <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding AutoRoute, Mode=TwoWay}" HorizontalAlignment="Right" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="自动选择接口" Description="自动选择出站网络接口">
                    <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding AutoDetectInterface, Mode=TwoWay}" HorizontalAlignment="Right" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="严格路由" Description="防止路由泄漏">
                    <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding StrictRoute, Mode=TwoWay}" HorizontalAlignment="Right" />
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock Text="高级设置" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="MTU" Description="虚拟网卡最大传输单元">
                    <TextBox Text="{Binding Mtu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="9000"
                             InputScope="Number"
                             Style="{StaticResource TunTextBoxStyle}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="设备名称" Description="留空时由内核自动生成">
                    <TextBox Text="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="自动"
                             Style="{StaticResource TunTextBoxStyle}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="DNS 劫持" Description="每行一个监听地址" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <TextBox AcceptsReturn="True"
                             MinHeight="96"
                             HorizontalAlignment="Stretch"
                             Text="{Binding DnsHijack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="路由排除地址" Description="不经过虚拟网卡的地址，每行一个" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <TextBox AcceptsReturn="True"
                             MinHeight="96"
                             HorizontalAlignment="Stretch"
                             Text="{Binding RouteExcludeAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
