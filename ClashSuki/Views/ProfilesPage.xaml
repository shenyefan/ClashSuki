<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSuki.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClashSuki.Controls"
    NavigationCacheMode="Enabled">
    <Grid x:Name="PageRoot">
        <ScrollViewer>
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageSpacing}">
                <TextBlock Text="订阅" Style="{StaticResource PageTitleStyle}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="订阅列表" Style="{StaticResource SectionTitleStyle}" />
                    <TextBox Grid.Column="1"
                             PlaceholderText="https://..."
                             Text="{Binding NewProfileUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                    <ui:IconActionButton Grid.Column="2" Command="{Binding AddProfileCommand}" Glyph="&#xE896;" VerticalAlignment="Center" ToolTipService.ToolTip="下载订阅" />
                    <ui:IconActionButton Grid.Column="3" Glyph="&#xE713;" VerticalAlignment="Center" ToolTipService.ToolTip="下载高级选项">
                        <ui:IconActionButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="380" Spacing="12">
                                    <TextBlock Text="下载高级选项" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                                    <TextBox Header="名称" PlaceholderText="留空自动推断" Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <PasswordBox Header="访问令牌" PlaceholderText="Authorization 标头内容" Password="{Binding NewAuthToken, Mode=TwoWay}" />
                                    <TextBox Header="User-Agent" PlaceholderText="留空使用全局默认" Text="{Binding NewUserAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <PasswordBox Header="Age 私钥" PlaceholderText="AGE-SECRET-KEY-..." Password="{Binding NewAgeSecretKey, Mode=TwoWay}" />
                                </StackPanel>
                            </Flyout>
                        </ui:IconActionButton.Flyout>
                    </ui:IconActionButton>
                    <ui:IconActionButton Grid.Column="4" Glyph="&#xE8B5;" VerticalAlignment="Center" ToolTipService.ToolTip="本地配置">
                        <ui:IconActionButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="400" Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="本地配置" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <TextBox Header="显示名称" PlaceholderText="留空使用文件名" Text="{Binding NewLocalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="从文件导入" Style="{StaticResource BodyTextStyle}" />
                                        <Button Click="ImportLocalFile_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="选择 .yaml / .yml 文件">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8E5;" FontSize="{StaticResource IconActionButtonIconFontSize}" />
                                                <TextBlock Text="选择文件并导入" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="新建空白配置" Style="{StaticResource BodyTextStyle}" />
                                        <TextBox Header="文件名" PlaceholderText="local.yaml" Text="{Binding NewLocalFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Command="{Binding CreateLocalProfileCommand}"
                                                HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="创建空白 YAML 并加入列表">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Grid Width="{StaticResource IconActionButtonViewportSize}" Height="{StaticResource IconActionButtonViewportSize}">
                                                    <ProgressRing Width="{StaticResource IconActionButtonViewportSize}"
                                                                  Height="{StaticResource IconActionButtonViewportSize}"
                                                                  IsActive="{Binding CreateLocalProfileCommand.IsRunning}"
                                                                  Visibility="{Binding CreateLocalProfileCommand.IsRunning, Converter={StaticResource BoolToVis}}" />
                                                    <FontIcon Glyph="&#xE710;"
                                                              FontSize="{StaticResource IconActionButtonIconFontSize}"
                                                              Visibility="{Binding CreateLocalProfileCommand.IsRunning, Converter={StaticResource InverseBoolToVis}}" />
                                                </Grid>
                                                <TextBlock Text="新建空白配置" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </ui:IconActionButton.Flyout>
                    </ui:IconActionButton>
                </Grid>

                <Grid Style="{StaticResource EmptyStateHostStyle}"
                      Visibility="{Binding ProfileCount, Converter={StaticResource NumberZeroToVis}}">
                    <StackPanel Style="{StaticResource EmptyStatePanelStyle}">
                        <FontIcon Glyph="&#xE8F1;" Style="{StaticResource EmptyStateIconStyle}" />
                        <TextBlock Text="暂无订阅" Style="{StaticResource EmptyStateTitleStyle}" />
                        <TextBlock Text="下载远程订阅或导入本地配置后会显示在这里。" Style="{StaticResource EmptyStateDescriptionStyle}" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Profiles.Items}"
                              Visibility="{Binding ProfileCount, Converter={StaticResource NumberNotZeroToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SettingsCard Header="{Binding Name}"
                                                   Description="{Binding SourceText}"
                                                   IsClickEnabled="True"
                                                   IsActionIconVisible="False"
                                                   Click="ProfileCard_Click"
                                                   Tag="{Binding}"
                                                   IsEnabled="{Binding DataContext.IsSwitchingProfile, ElementName=PageRoot, Converter={StaticResource InverseBool}}"
                                                   Background="{Binding CardBackgroundBrush}"
                                                   BorderBrush="{Binding CardBorderBrush}"
                                                   BorderThickness="{Binding CardBorderThickness}"
                                                   FontWeight="{Binding NameFontWeight}"
                                                   Margin="0,0,0,4">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE8F1;">
                                        <FontIcon.Foreground>
                                            <SolidColorBrush Color="{Binding StatusColor}" />
                                        </FontIcon.Foreground>
                                    </FontIcon>
                                </controls:SettingsCard.HeaderIcon>
                                <Grid ColumnSpacing="8"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="228" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Spacing="2"
                                                Width="228"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusAndUpdatedText}"
                                                   Style="{StaticResource MutedCaptionTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding UpdatePolicyText}"
                                                   Style="{StaticResource MutedCaptionTextStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsRemote, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1"
                                          Width="32"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <ProgressRing Width="20"
                                                      Height="20"
                                                      IsActive="{Binding IsBusy}"
                                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <ui:IconActionButton Grid.Column="2"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Glyph="&#xE712;"
                                            ToolTipService.ToolTip="更多">
                                        <ui:IconActionButton.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="更新订阅"
                                                                Click="UpdateProfile_Click"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding IsRemote, Converter={StaticResource BoolToVis}}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE896;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="编辑订阅信息" Click="EditProfile_Click" Tag="{Binding}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="编辑配置文件" Click="OpenProfileFile_Click" Tag="{Binding}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8A5;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="删除" Click="DeleteProfile_Click" Tag="{Binding}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </ui:IconActionButton.Flyout>
                                    </ui:IconActionButton>
                                </Grid>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:Name="EditProfileDialog"
                       Title="编辑订阅"
                       PrimaryButtonText="保存"
                       CloseButtonText="取消"
                       DefaultButton="Primary"
                       PrimaryButtonClick="EditProfileDialog_PrimaryButtonClick">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">500</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">500</x:Double>
            </ContentDialog.Resources>
            <StackPanel Width="420"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Spacing="12">
                <TextBox Header="名称"
                         Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="URL"
                         Text="{Binding EditUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditingRemote, Converter={StaticResource BoolToVis}}" />
                <PasswordBox Header="访问令牌"
                             Password="{Binding EditAuthToken, Mode=TwoWay}"
                             Visibility="{Binding IsEditingRemote, Converter={StaticResource BoolToVis}}" />
                <TextBox Header="User-Agent"
                         Text="{Binding EditUserAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditingRemote, Converter={StaticResource BoolToVis}}" />
                <PasswordBox Header="Age 私钥"
                             Password="{Binding EditAgeSecretKey, Mode=TwoWay}" />

                <Grid ColumnSpacing="16" Visibility="{Binding IsEditingRemote, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="自动更新" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1"
                                  MinWidth="0"
                                  Width="48"
                                  OnContent=""
                                  OffContent=""
                                  IsOn="{Binding EditAutoUpdate, Mode=TwoWay}" />
                </Grid>

                <TextBox Header="更新间隔（分钟）"
                         PlaceholderText="留空默认 1440"
                         Text="{Binding EditUpdateIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditingRemote, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="ProfileFileDialog"
                       Title="编辑配置文件"
                       PrimaryButtonText="保存"
                       CloseButtonText="取消"
                       DefaultButton="Primary"
                       PrimaryButtonClick="ProfileFileDialog_PrimaryButtonClick">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">840</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">840</x:Double>
            </ContentDialog.Resources>
            <StackPanel Width="760"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Spacing="12">
                <TextBlock x:Name="ProfileFilePathText"
                           Style="{StaticResource MutedCaptionTextStyle}"
                           MaxWidth="760"
                           TextTrimming="CharacterEllipsis" />
                <RichEditBox x:Name="ProfileFileEditor"
                             Width="760"
                             Height="520"
                             FontFamily="Consolas"
                             FontSize="13"
                             TextWrapping="NoWrap"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             IsSpellCheckEnabled="False"
                             IsTextPredictionEnabled="False" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
