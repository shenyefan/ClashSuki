<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSuki.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClashSuki.Controls"
    NavigationCacheMode="Enabled">
    <Page.Resources>
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="280" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SettingsNumberBoxStyle" TargetType="NumberBox">
            <Setter Property="Width" Value="140" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageSpacing}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <ui:IconActionButton Grid.Column="1" Click="ResetSettings_Click" Glyph="&#xE72C;" IsLoading="{Binding ResetSettingsCommand.IsRunning}" ToolTipService.ToolTip="恢复默认设置" />
                <ui:IconActionButton Grid.Column="2" Command="{Binding SaveCommand}" Glyph="&#xE74E;" ToolTipService.ToolTip="保存设置" />
            </Grid>

            <controls:SettingsExpander Header="常规" Description="启动、外观与基础行为" IsExpanded="True">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="开机自启" Description="登录 Windows 后自动启动 ClashSuki">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.AutoRun, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="静默启动" Description="启动时直接进入托盘，不显示主窗口">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.SilentStart, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="关闭时最小化到托盘" Description="关闭窗口时保留后台运行">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.CloseToTray, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="环境变量类型" Description="托盘复制代理环境变量时使用">
                        <ComboBox SelectedIndex="{Binding EnvTypeIndex, Mode=TwoWay}" MinWidth="160" HorizontalAlignment="Right">
                            <ComboBoxItem Content="PowerShell" />
                            <ComboBoxItem Content="CMD" />
                            <ComboBoxItem Content="Bash" />
                            <ComboBoxItem Content="Fish" />
                            <ComboBoxItem Content="Nushell" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="主题" Description="切换应用外观">
                        <ComboBox SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" MinWidth="160" HorizontalAlignment="Right">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="窗口背景" Description="使用 Windows 原生窗口材质">
                        <ComboBox SelectedIndex="{Binding BackdropIndex, Mode=TwoWay}" MinWidth="160" HorizontalAlignment="Right">
                            <ComboBoxItem Content="Mica" />
                            <ComboBoxItem Content="Acrylic" />
                            <ComboBoxItem Content="纯色" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="退出应用" Description="停止后台任务并退出 ClashSuki">
                        <ui:IconActionButton Command="{Binding ExitAppCommand}" Glyph="&#xE8BB;" ToolTipService.ToolTip="退出应用" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="网络与订阅" Description="下载代理、订阅请求和测速参数">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="GitHub 下载代理" Description="例如 https://ghproxy.net/">
                        <TextBox Style="{StaticResource SettingsTextBoxStyle}" Text="{Binding Settings.GitHubProxy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="订阅 User Agent" Description="单个订阅未设置时使用">
                        <TextBox Style="{StaticResource SettingsTextBoxStyle}" Text="{Binding Settings.UserAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="订阅超时时间" Description="下载与更新订阅时的 HTTP 超时（秒）">
                        <NumberBox Style="{StaticResource SettingsNumberBoxStyle}" Value="{Binding SubscriptionTimeout, Mode=TwoWay}" Minimum="1" Maximum="600" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="下载订阅时使用代理" Description="通过本地 mixed-port 拉取订阅，不勾选则先直连、失败再回退代理">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.ProfileUseProxy, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="延迟测试 URL" Description="节点测速默认地址">
                        <TextBox Style="{StaticResource SettingsTextBoxStyle}" Text="{Binding Settings.DelayTestUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="延迟测试并发数" Description="批量测速最大并发">
                        <NumberBox Style="{StaticResource SettingsNumberBoxStyle}" Value="{Binding DelayTestConcurrency, Mode=TwoWay}" Minimum="1" Maximum="100" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="延迟测试超时" Description="毫秒">
                        <NumberBox Style="{StaticResource SettingsNumberBoxStyle}" Value="{Binding DelayTestTimeout, Mode=TwoWay}" Minimum="1000" Maximum="60000" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="Gist 同步" Description="同步运行时配置到 GitHub Gist">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="同步运行时配置到 Gist" Description="保存当前运行配置到 Gist">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.SyncRuntimeConfigToGist, Mode=TwoWay}" />
                            <ui:IconActionButton Command="{Binding SyncGistCommand}" Glyph="&#xE895;" ToolTipService.ToolTip="立即同步" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="GitHub Token" Description="需要 gist 权限">
                        <TextBox Style="{StaticResource SettingsTextBoxStyle}" Text="{Binding Settings.GitHubToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Gist ID" Description="留空时新建私有 Gist">
                        <TextBox Style="{StaticResource SettingsTextBoxStyle}" Text="{Binding Settings.GistId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Gist 运行时配置 Age 加密" Description="使用 Age 公钥加密后上传">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.GistAgeEncrypt, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Gist Age 接收方公钥" Description="age1...">
                        <TextBox Style="{StaticResource SettingsTextBoxStyle}" Text="{Binding Settings.GistAgeRecipient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Gist Age 密钥" Description="用于保存/导出本机 Age 私钥">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <TextBox Width="280" Text="{Binding Settings.GistAgeSecretKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:IconActionButton Command="{Binding GenerateAgeKeyCommand}" Glyph="&#xE72C;" ToolTipService.ToolTip="生成 Age 密钥" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="内核与配置" Description="进程、工作目录和配置切换策略">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="核心进程优先级" Description="sidecar 模式下应用">
                        <ComboBox SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}" MinWidth="160" HorizontalAlignment="Right">
                            <ComboBoxItem Content="Idle" />
                            <ComboBoxItem Content="Below normal" />
                            <ComboBoxItem Content="Normal" />
                            <ComboBoxItem Content="Above normal" />
                            <ComboBoxItem Content="High" />
                            <ComboBoxItem Content="Real time" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="不同订阅使用独立工作目录" Description="保存设置供内核启动和订阅切换使用">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.DiffWorkDir, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="切换订阅时热重载配置" Description="关闭后切换订阅会重启内核">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.UseHotReloadProfile, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="热重载切换订阅时关闭连接" Description="热重载订阅前关闭现有连接">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.HotReloadProfileAutoCloseConnection, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="切换代理/模式时关闭连接" Description="切换节点或模式后关闭现有连接">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.AutoCloseConnection, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="启动时检查配置文件" Description="启动内核前运行 mihomo 配置校验">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.TestProfileOnStart, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="网络环境" Description="指定 WiFi SSID 下自动直连">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="指定 WiFi SSID 直连" Description="每行一个 SSID" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <TextBox AcceptsReturn="True" MinHeight="96" HorizontalAlignment="Stretch" Text="{Binding Settings.PauseSsid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="直连时使用系统默认 DNS" Description="SSID 直连时不强制应用内 DNS">
                        <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Settings.DisableDnsOnPauseSsid, Mode=TwoWay}" HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="维护" Description="备份、恢复与重置">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="备份与恢复" Description="备份应用数据或恢复最新备份">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <ui:IconActionButton Command="{Binding CreateBackupCommand}" Glyph="&#xE8F1;" ToolTipService.ToolTip="创建备份" />
                            <ui:IconActionButton Click="RestoreLatestBackup_Click" Glyph="&#xE777;" IsLoading="{Binding RestoreLatestBackupCommand.IsRunning}" ToolTipService.ToolTip="恢复最新备份" />
                            <ui:IconActionButton Command="{Binding OpenBackupDirectoryCommand}" Glyph="&#xE8B7;" ToolTipService.ToolTip="打开备份目录" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="重置软件" Description="重置应用设置，重置前会自动创建备份">
                        <ui:IconActionButton Click="ResetSoftware_Click" Glyph="&#xE74D;" IsLoading="{Binding ResetSoftwareCommand.IsRunning}" ToolTipService.ToolTip="重置软件" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
