<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSuki.Views.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:ui="using:ClashSuki.Controls"
    NavigationCacheMode="Enabled">
    <Page.Resources>
        <Style x:Key="ResourceUrlTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="560" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot">
        <ScrollViewer>
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageSpacing}">
                <TextBlock Text="外部资源" Style="{StaticResource PageTitleStyle}" />

                <TextBlock Text="GeoData" Style="{StaticResource SectionTitleStyle}" />
                <StackPanel Spacing="4">
                    <controls:SettingsCard Header="GeoIP 数据库" Description="GeoIP 数据源地址">
                        <TextBox Tag="geoip"
                                 Text="{Binding GeoIpUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ResourceUrlTextBoxStyle}"
                                 LostFocus="GeoUrlTextBox_LostFocus"
                                 KeyDown="GeoUrlTextBox_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="GeoSite 数据库" Description="GeoSite 数据源地址">
                        <TextBox Tag="geosite"
                                 Text="{Binding GeoSiteUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ResourceUrlTextBoxStyle}"
                                 LostFocus="GeoUrlTextBox_LostFocus"
                                 KeyDown="GeoUrlTextBox_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="MMDB 数据库" Description="MMDB 数据源地址">
                        <TextBox Tag="mmdb"
                                 Text="{Binding MmdbUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ResourceUrlTextBoxStyle}"
                                 LostFocus="GeoUrlTextBox_LostFocus"
                                 KeyDown="GeoUrlTextBox_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="ASN 数据库" Description="ASN 数据源地址">
                        <TextBox Tag="asn"
                                 Text="{Binding AsnUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ResourceUrlTextBoxStyle}"
                                 LostFocus="GeoUrlTextBox_LostFocus"
                                 KeyDown="GeoUrlTextBox_KeyDown" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="GeoData 数据模式" Description="切换 db 或 dat 数据格式">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <primitives:ToggleButton Content="db" IsChecked="{Binding GeoDataMode, Converter={StaticResource InverseBool}, Mode=OneWay}" Click="GeoModeDb_Click" />
                            <primitives:ToggleButton Content="dat" IsChecked="{Binding GeoDataMode, Mode=OneWay}" Click="GeoModeDat_Click" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="自动更新" Description="按间隔更新 GeoData 资源">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <ui:IconActionButton Command="{Binding UpdateGeoDataCommand}" AutoSyncLoadingFromCommand="False" Glyph="&#xE72C;" IsLoading="{Binding IsUpdatingGeoData}" ToolTipService.ToolTip="手动更新 GeoData" />
                            <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding GeoAutoUpdate, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="更新间隔（小时）" Description="自动更新的时间间隔" Visibility="{Binding GeoAutoUpdate, Converter={StaticResource BoolToVis}}">
                        <NumberBox Width="150"
                                   HorizontalAlignment="Right"
                                   Value="{Binding GeoUpdateIntervalValue, Mode=TwoWay}"
                                   Minimum="1"
                                   Maximum="168"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Compact" />
                    </controls:SettingsCard>
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="规则集合" Style="{StaticResource SectionTitleStyle}" />
                    <TextBox Grid.Column="1"
                             PlaceholderText="搜索规则集合"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                    <ui:IconActionButton Grid.Column="2"
                            Command="{Binding UpdateAllRuleProvidersCommand}"
                            AutoSyncLoadingFromCommand="False"
                            Glyph="&#xE72C;"
                            IsLoading="{Binding IsUpdatingAll}"
                            ToolTipService.ToolTip="更新全部规则集合" />
                </Grid>

                <StackPanel Spacing="4">
                    <controls:SettingsCard ContentAlignment="Vertical"
                                           HorizontalContentAlignment="Stretch"
                                           Visibility="{Binding FilteredRuleProviderCount, Converter={StaticResource NumberZeroToVis}}">
                        <Grid Style="{StaticResource EmptyStateHostStyle}">
                            <StackPanel Style="{StaticResource EmptyStatePanelStyle}">
                                <FontIcon Glyph="&#xE8A5;" Style="{StaticResource EmptyStateIconStyle}" />
                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource EmptyStateTitleStyle}" />
                                <TextBlock Text="规则集合会在配置加载后显示。" Style="{StaticResource EmptyStateDescriptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </controls:SettingsCard>

                    <ItemsControl ItemsSource="{Binding FilteredRuleProviders}"
                                  HorizontalAlignment="Stretch"
                                  Visibility="{Binding FilteredRuleProviderCount, Converter={StaticResource NumberNotZeroToVis}}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:SettingsCard Header="{Binding Name}" Description="{Binding DetailText}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <ui:IconActionButton Command="{Binding DataContext.OpenRuleProviderCommand, ElementName=PageRoot}"
                                                AutoSyncLoadingFromCommand="False"
                                                CommandParameter="{Binding}"
                                                Glyph="&#xE7B3;"
                                                IsLoading="{Binding IsViewing}"
                                                ToolTipService.ToolTip="查看规则" />
                                        <ui:IconActionButton Command="{Binding DataContext.UpdateRuleProviderCommand, ElementName=PageRoot}"
                                                AutoSyncLoadingFromCommand="False"
                                                CommandParameter="{Binding}"
                                                Glyph="&#xE72C;"
                                                IsLoading="{Binding IsUpdating}"
                                                ToolTipService.ToolTip="更新" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:Name="RuleProviderDialog"
                       Title="{Binding ViewerTitle}"
                       CloseButtonText="关闭"
                       SecondaryButtonText="打开文件位置"
                       DefaultButton="Close"
                       SecondaryButtonClick="RuleProviderDialog_SecondaryButtonClick"
                       Closed="RuleProviderDialog_Closed">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">800</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
            </ContentDialog.Resources>
            <StackPanel Width="720"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="搜索规则"
                             Text="{Binding ViewerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ViewerMatchText}"
                               Style="{StaticResource MutedCaptionTextStyle}"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding ViewerSource}" Style="{StaticResource MutedCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                <ListView ItemsSource="{Binding ViewerLines}"
                          SelectionMode="None"
                          FontFamily="Consolas"
                          FontSize="13"
                          MaxHeight="460"
                          HorizontalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="22" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding NumberText}"
                                           Style="{StaticResource MutedCaptionTextStyle}"
                                           TextAlignment="Right"
                                           FontFamily="Consolas"
                                           FontSize="12" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Text}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontFamily="Consolas"
                                           FontSize="13" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
