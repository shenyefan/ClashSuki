<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSuki.Views.OverridePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClashSuki.Controls"
    NavigationCacheMode="Enabled">
    <Grid x:Name="PageRoot">
        <ScrollViewer>
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageSpacing}">
                <TextBlock Text="覆写" Style="{StaticResource PageTitleStyle}" />

                <TextBlock Text="内置覆写" Style="{StaticResource SectionTitleStyle}" />
                <StackPanel Spacing="4">
                    <controls:SettingsCard Header="DNS 与 Hosts" Description="关闭后完整使用当前订阅的 DNS 与 Hosts 配置">
                        <ToggleSwitch MinWidth="0"
                                      Width="48"
                                      OnContent=""
                                      OffContent=""
                                      IsOn="{Binding DnsOverrideEnabled, Mode=OneWay}"
                                      Toggled="DnsOverrideSwitch_Toggled"
                                      HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="嗅探" Description="关闭后完整使用当前订阅的嗅探配置">
                        <ToggleSwitch MinWidth="0"
                                      Width="48"
                                      OnContent=""
                                      OffContent=""
                                      IsOn="{Binding SnifferOverrideEnabled, Mode=OneWay}"
                                      Toggled="SnifferOverrideSwitch_Toggled"
                                      HorizontalAlignment="Right" />
                    </controls:SettingsCard>
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="覆写列表" Style="{StaticResource SectionTitleStyle}" />
                    <TextBox Grid.Column="1"
                             PlaceholderText="https://.../override.yaml"
                             Text="{Binding ImportUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                    <ui:IconActionButton Grid.Column="2" Command="{Binding ImportUrlCommand}" Glyph="&#xE896;" ToolTipService.ToolTip="导入远程覆写" />
                    <ui:IconActionButton Grid.Column="3" Glyph="&#xE713;" VerticalAlignment="Center" ToolTipService.ToolTip="下载高级选项">
                        <ui:IconActionButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="380" Spacing="12">
                                    <TextBlock Text="下载高级选项" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                                    <PasswordBox Header="Token" PlaceholderText="Authorization 请求头" Password="{Binding ImportAuthToken, Mode=TwoWay}" />
                                    <TextBox Header="User-Agent" PlaceholderText="留空使用全局默认" Text="{Binding ImportUserAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Flyout>
                        </ui:IconActionButton.Flyout>
                    </ui:IconActionButton>
                    <ui:IconActionButton Grid.Column="4" Glyph="&#xE710;" ToolTipService.ToolTip="添加覆写">
                        <ui:IconActionButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="打开文件" Click="ImportFile_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="新建 YAML" Click="NewYaml_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="新建 JavaScript" Click="NewJs_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE943;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ui:IconActionButton.Flyout>
                    </ui:IconActionButton>
                    <ui:IconActionButton Grid.Column="5" Command="{Binding ApplyCommand}" Glyph="&#xE73E;" ToolTipService.ToolTip="应用已启用的覆写" />
                </Grid>

                <Grid Style="{StaticResource EmptyStateHostStyle}"
                      Visibility="{Binding ItemCount, Converter={StaticResource NumberZeroToVis}}">
                    <StackPanel Style="{StaticResource EmptyStatePanelStyle}">
                        <FontIcon Glyph="&#xE70F;" Style="{StaticResource EmptyStateIconStyle}" />
                        <TextBlock Text="暂无覆写" Style="{StaticResource EmptyStateTitleStyle}" />
                        <TextBlock Text="导入或新建覆写后会显示在这里。" Style="{StaticResource EmptyStateDescriptionStyle}" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Items}"
                              Visibility="{Binding ItemCount, Converter={StaticResource NumberNotZeroToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SettingsCard Header="{Binding Name}" Description="{Binding DetailText}" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <ui:IconActionButton Click="RefreshRemote_Click"
                                            AutoSyncLoadingFromCommand="False"
                                            Glyph="&#xE72C;"
                                            IsLoading="{Binding IsUpdating}"
                                            Visibility="{Binding IsRemote, Converter={StaticResource BoolToVis}}"
                                            ToolTipService.ToolTip="刷新远程覆写" />
                                    <ToggleSwitch MinWidth="0"
                                                  Width="48"
                                                  OnContent=""
                                                  OffContent=""
                                                  IsOn="{Binding Enabled, Mode=OneWay}"
                                                  Toggled="EnabledSwitch_Toggled" />
                                    <ui:IconActionButton Glyph="&#xE712;" ToolTipService.ToolTip="更多">
                                        <ui:IconActionButton.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="编辑信息" Click="EditInfo_Click" Tag="{Binding}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE946;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="编辑文件" Click="EditFile_Click" Tag="{Binding}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="打开文件" Click="OpenFile_Click" Tag="{Binding}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8E5;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="执行日志"
                                                                Click="ViewLog_Click"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding IsJavaScript, Converter={StaticResource BoolToVis}}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xF000;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="删除" Click="Delete_Click" Tag="{Binding}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </ui:IconActionButton.Flyout>
                                    </ui:IconActionButton>
                                </StackPanel>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:Name="EditInfoDialog"
                       Title="{Binding InfoTitle}"
                       PrimaryButtonText="保存"
                       CloseButtonText="取消"
                       DefaultButton="Primary"
                       PrimaryButtonClick="EditInfoDialog_PrimaryButtonClick">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">500</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">500</x:Double>
            </ContentDialog.Resources>
            <StackPanel Width="420"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Spacing="12">
                <TextBlock Text="{Binding InfoTypeText}"
                           Style="{StaticResource MutedCaptionTextStyle}" />
                <TextBox Header="显示名称"
                         Text="{Binding InfoName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Header="地址"
                         Text="{Binding InfoUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsInfoEditingRemote, Converter={StaticResource BoolToVis}}" />
                <PasswordBox Header="Token"
                             Password="{Binding InfoAuthToken, Mode=TwoWay}"
                             Visibility="{Binding IsInfoEditingRemote, Converter={StaticResource BoolToVis}}" />
                <TextBox Header="User-Agent"
                         PlaceholderText="留空使用全局默认"
                         Text="{Binding InfoUserAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsInfoEditingRemote, Converter={StaticResource BoolToVis}}" />

                <Grid ColumnSpacing="16" Visibility="{Binding IsInfoEditingRemote, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="自动更新" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1"
                                  MinWidth="0"
                                  Width="48"
                                  OnContent=""
                                  OffContent=""
                                  IsOn="{Binding InfoAutoUpdate, Mode=TwoWay}" />
                </Grid>

                <TextBox Header="更新间隔（分钟）"
                         PlaceholderText="留空默认 1440"
                         Text="{Binding InfoUpdateIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsInfoEditingRemote, Converter={StaticResource BoolToVis}}" />
                <TextBox Header="下载超时（秒）"
                         PlaceholderText="留空使用全局订阅超时"
                         Text="{Binding InfoUpdateTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsInfoEditingRemote, Converter={StaticResource BoolToVis}}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="全局启用" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="应用覆写时包含此项目" Style="{StaticResource MutedCaptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  MinWidth="0"
                                  Width="48"
                                  OnContent=""
                                  OffContent=""
                                  IsOn="{Binding InfoEnabled, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="EditDialog"
                       Title="{Binding EditorTitle}"
                       PrimaryButtonText="保存"
                       CloseButtonText="取消"
                       DefaultButton="Primary"
                       PrimaryButtonClick="EditDialog_PrimaryButtonClick">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">840</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">840</x:Double>
            </ContentDialog.Resources>
            <StackPanel Width="760" Spacing="12">
                <TextBlock Text="{Binding EditorPath}" Style="{StaticResource MutedCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                <TextBox Text="{Binding EditorContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         Width="760"
                         Height="520"
                         HorizontalAlignment="Stretch"
                         FontFamily="Consolas"
                         FontSize="13"
                         TextWrapping="NoWrap"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="LogDialog"
                       Title="{Binding LogTitle}"
                       CloseButtonText="关闭"
                       DefaultButton="Close">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">760</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
            </ContentDialog.Resources>
            <StackPanel Width="680" Spacing="12">
                <TextBlock Text="{Binding LogPath}"
                           Style="{StaticResource MutedCaptionTextStyle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBox Text="{Binding LogContent, Mode=OneWay}"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         Width="680"
                         Height="420"
                         HorizontalAlignment="Stretch"
                         FontFamily="Consolas"
                         FontSize="13"
                         TextWrapping="NoWrap"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
