<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSuki.Views.SysProxyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:services="using:ClashSuki.Services"
    xmlns:ui="using:ClashSuki.Controls"
    NavigationCacheMode="Enabled">
    <Grid>
        <ScrollViewer HorizontalContentAlignment="Stretch">
            <StackPanel Padding="{StaticResource PagePadding}"
                        Spacing="{StaticResource PageSpacing}"
                        HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="系统代理" Style="{StaticResource PageTitleStyle}" />
                <ui:IconActionButton Grid.Column="1" Click="ResetSystemProxySettings_Click" Glyph="&#xE72C;" IsLoading="{Binding ResetSystemProxySettingsCommand.IsRunning}" VerticalAlignment="Center" ToolTipService.ToolTip="恢复默认值" />
                <ui:IconActionButton Grid.Column="2" Command="{Binding SaveSystemProxySettingsCommand}" Glyph="&#xE74E;" VerticalAlignment="Center" ToolTipService.ToolTip="保存设置" />
            </Grid>

            <TextBlock Text="代理" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="启用系统代理" Description="{Binding Runtime.MixedPortText}">
                    <ToggleSwitch MinWidth="0"
                                  Width="48"
                                  OnContent=""
                                  OffContent=""
                                  IsOn="{Binding Runtime.IsSystemProxyEnabled, Mode=OneWay}"
                                  Toggled="SysProxy_Toggled"
                                  HorizontalAlignment="Right" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="代理主机" Description="系统代理服务器地址">
                    <TextBox Width="220"
                             HorizontalAlignment="Right"
                             Text="{Binding SystemProxyHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="127.0.0.1" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="代理模式" Description="选择手动代理或 PAC 脚本">
                    <ComboBox SelectedIndex="{Binding SystemProxyModeIndex, Mode=TwoWay}"
                              MinWidth="136"
                              HorizontalAlignment="Right">
                        <ComboBoxItem Content="手动" />
                        <ComboBoxItem Content="PAC" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard x:Name="UwpLoopbackCard"
                                       Header="UWP 应用代理"
                                       Description="{Binding Runtime.UwpLoopbackDescription}"
                                       IsEnabled="{Binding Runtime.IsTunToggleAvailable}"
                                       IsClickEnabled="True"
                                       ActionIconToolTip="配置 UWP 应用代理"
                                       Click="OpenUwpLoopback_Click">
                    <ProgressRing x:Name="UwpLoopbackLoadingRing"
                                  Width="20"
                                  Height="20"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  AutomationProperties.Name="正在读取应用列表" />
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock Text="PAC" Style="{StaticResource SectionTitleStyle}" Visibility="{Binding IsPacMode, Converter={StaticResource BoolToVis}}" />
            <controls:SettingsCard Header="PAC 脚本" Description="保存后应用到系统代理" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" Visibility="{Binding IsPacMode, Converter={StaticResource BoolToVis}}">
                <TextBox AcceptsReturn="True"
                         MinHeight="180"
                         HorizontalAlignment="Stretch"
                         Text="{Binding PacScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:SettingsCard>

            <TextBlock Text="绕过列表" Style="{StaticResource SectionTitleStyle}" Visibility="{Binding IsPacMode, Converter={StaticResource InverseBoolToVis}}" />
            <controls:SettingsCard Header="不使用代理的地址" Description="每行一条地址或规则" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch" Visibility="{Binding IsPacMode, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Spacing="12">
                    <TextBox AcceptsReturn="True"
                             MinHeight="180"
                             HorizontalAlignment="Stretch"
                             Text="{Binding BypassList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="localhost&#x0a;127.0.0.1&#x0a;192.168.0.0/16&#x0a;10.0.0.0/8" />
                </StackPanel>
            </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:Name="UwpLoopbackDialog"
                       Title="UWP 应用代理"
                       PrimaryButtonText="保存"
                       CloseButtonText="取消"
                       DefaultButton="Primary"
                       Closing="UwpLoopbackDialog_Closing"
                       PrimaryButtonClick="UwpLoopbackDialog_PrimaryButtonClick">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="选择可访问本机代理的 Microsoft Store 应用。保存后将更新所选应用的本机回环权限。"
                           TextWrapping="WrapWholeWords"
                           Style="{StaticResource BodyTextBlockStyle}" />

                <InfoBar x:Name="UwpLoopbackInfoBar"
                         Grid.Row="1"
                         IsOpen="False"
                         IsClosable="True" />

                <CommandBar Grid.Row="2"
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            HorizontalAlignment="Stretch">
                    <CommandBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="UwpLoopbackSavingRing"
                                          Width="16"
                                          Height="16"
                                          IsActive="False"
                                          Visibility="Collapsed"
                                          AutomationProperties.Name="正在保存应用代理设置" />
                            <TextBlock x:Name="UwpLoopbackSelectionSummary"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </CommandBar.Content>
                    <AppBarButton x:Name="UwpLoopbackSelectAllButton"
                                  Icon="SelectAll"
                                  Label="全选"
                                  Click="UwpLoopbackSelectAll_Click" />
                    <AppBarButton x:Name="UwpLoopbackClearSelectionButton"
                                  Icon="ClearSelection"
                                  Label="取消全选"
                                  Click="UwpLoopbackClearSelection_Click" />
                </CommandBar>

                <TextBlock x:Name="UwpLoopbackListLabel"
                           Grid.Row="3"
                           Text="应用列表"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <ListView x:Name="UwpLoopbackList"
                          Grid.Row="4"
                          MaxHeight="440"
                          SelectionMode="Multiple"
                          SelectionChanged="UwpLoopbackList_SelectionChanged"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          AutomationProperties.LabeledBy="{Binding ElementName=UwpLoopbackListLabel}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="56" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:UwpLoopbackApp">
                            <StackPanel Padding="4" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind PackageFamilyName}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ContentDialog>
    </Grid>
</Page>
