<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClashSuki.Views.CorePage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClashSuki.Controls"
    xmlns:vm="using:ClashSuki.ViewModels"
    NavigationCacheMode="Enabled">
    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel Padding="{StaticResource PagePadding}"
                    Spacing="{StaticResource PageSpacing}"
                    HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="内核" Style="{StaticResource PageTitleStyle}" />
                <ui:IconActionButton Grid.Column="1" Command="{Binding ValidateConfigCommand}" Glyph="&#xE9D9;" VerticalAlignment="Center" ToolTipService.ToolTip="校验配置" />
                <ui:IconActionButton Grid.Column="2" Command="{Binding RestartCoreCommand}" Glyph="&#xE777;" VerticalAlignment="Center" ToolTipService.ToolTip="重启内核" />
                <ui:IconActionButton Grid.Column="3" Click="ResetConfig_Click" Glyph="&#xE72C;" IsLoading="{Binding ResetConfigCommand.IsRunning}" VerticalAlignment="Center" ToolTipService.ToolTip="重置内核配置" />
                <ui:IconActionButton Grid.Column="4" Command="{Binding SaveConfigCommand}" Glyph="&#xE74E;" VerticalAlignment="Center" ToolTipService.ToolTip="保存并重启内核" />
            </Grid>

            <TextBlock Text="状态" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="运行状态">
                    <TextBlock Text="{Binding Runtime.CoreStatusText}" FontWeight="SemiBold" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="当前版本">
                    <TextBlock Text="{Binding Runtime.MihomoVersion}" FontWeight="SemiBold" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="目录" Description="内核文件与运行配置">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <ui:IconActionButton Command="{Binding OpenCoreDirectoryCommand}" Glyph="&#xE8B7;" ToolTipService.ToolTip="打开内核目录" />
                        <ui:IconActionButton Command="{Binding OpenConfigDirectoryCommand}" Glyph="&#xE8A5;" ToolTipService.ToolTip="打开配置目录" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock Text="版本管理" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="发行通道" Description="选择后点击“应用”，下载并启动对应内核">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <ComboBox SelectedIndex="{Binding CoreReleaseIndex, Mode=TwoWay}" MinWidth="136">
                            <ComboBoxItem Content="最新版" />
                            <ComboBoxItem Content="预览版" />
                            <ComboBoxItem Content="Smart" />
                            <ComboBoxItem Content="指定版本" />
                        </ComboBox>
                        <ui:IconActionButton Click="ApplyCoreRelease_Click" AutoSyncLoadingFromCommand="False" Glyph="&#xE73E;" IsLoading="{Binding ApplyCoreReleaseCommand.IsRunning}" ToolTipService.ToolTip="应用所选通道" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="指定版本" Description="版本标签，例如 v1.19.13" Visibility="{Binding IsSpecificCoreSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <ComboBox MinWidth="180"
                                  PlaceholderText="选择版本"
                                  ItemsSource="{Binding CoreVersions}"
                                  SelectedItem="{Binding CoreSpecificVersion, Mode=TwoWay}"
                                  IsEnabled="{Binding IsCoreVersionsLoading, Converter={StaticResource InverseBool}}" />
                        <ui:IconActionButton Command="{Binding RefreshCoreVersionsCommand}" AutoSyncLoadingFromCommand="False" Glyph="&#xE72C;" IsLoading="{Binding IsCoreVersionsLoading}" ToolTipService.ToolTip="刷新版本列表" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock Text="内核维护" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="GeoData" Description="更新 GeoIP、GeoSite 和 MMDB 数据">
                    <ui:IconActionButton Command="{Binding UpdateGeoCommand}" Glyph="&#xE895;" ToolTipService.ToolTip="更新 GeoData" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Fake-IP 缓存" Description="清空内核 DNS 的 Fake-IP 缓存">
                    <ui:IconActionButton Command="{Binding FlushFakeIpCommand}" Glyph="&#xE74D;" ToolTipService.ToolTip="清空 Fake-IP 缓存" />
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock Text="监听端口" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="混合端口" Description="HTTP 与 SOCKS 共用；0 表示关闭">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <NumberBox Width="120" Value="{Binding MixedPort, Mode=TwoWay}" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact" />
                        <ui:IconActionButton Command="{Binding RandomizeMixedPortCommand}" Glyph="&#xE8B1;" ToolTipService.ToolTip="随机端口" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="SOCKS 端口" Description="0 表示关闭">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <NumberBox Width="120" Value="{Binding SocksPort, Mode=TwoWay}" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact" />
                        <ui:IconActionButton Command="{Binding RandomizeSocksPortCommand}" Glyph="&#xE8B1;" ToolTipService.ToolTip="随机端口" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="HTTP 端口" Description="0 表示关闭">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <NumberBox Width="120" Value="{Binding HttpPort, Mode=TwoWay}" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact" />
                        <ui:IconActionButton Command="{Binding RandomizeHttpPortCommand}" Glyph="&#xE8B1;" ToolTipService.ToolTip="随机端口" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="重定向端口" Description="Windows 通常无需开启；0 表示关闭">
                    <NumberBox Width="120" HorizontalAlignment="Right" Value="{Binding RedirPort, Mode=TwoWay}" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="TProxy 端口" Description="Windows 通常无需开启；0 表示关闭">
                    <NumberBox Width="120" HorizontalAlignment="Right" Value="{Binding TproxyPort, Mode=TwoWay}" Minimum="0" Maximum="65535" SpinButtonPlacementMode="Compact" />
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock Text="外部控制" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="启用外部控制" Description="本应用无需开启；开启后其他程序可通过 HTTP API 控制内核。修改后需保存并重启。">
                    <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding EnableExternalController, Mode=TwoWay}" HorizontalAlignment="Right" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="控制器地址" Description="外部控制 API 的监听地址">
                    <TextBox Width="260"
                             HorizontalAlignment="Right"
                             IsEnabled="{Binding EnableExternalController}"
                             Text="{Binding ExternalController, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="访问密钥" Description="用于保护外部控制 API">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <TextBox Width="260"
                                 IsEnabled="{Binding EnableExternalController}"
                                 Text="{Binding Secret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:IconActionButton Command="{Binding GenerateSecretCommand}"
                                IsEnabled="{Binding EnableExternalController}"
                                Glyph="&#xE72C;"
                                ToolTipService.ToolTip="生成密钥" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock Text="WebUI" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="新增面板"
                                       Description="URL 可使用 %host、%port 和 %secret 变量"
                                       ContentAlignment="Vertical"
                                       HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="名称" Text="{Binding NewWebUiName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1" PlaceholderText="https://...%host...%port...%secret" Text="{Binding NewWebUiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:IconActionButton Grid.Column="2" Command="{Binding AddWebUiPanelCommand}" Glyph="&#xE710;" ToolTipService.ToolTip="添加 WebUI" />
                    </Grid>
                </controls:SettingsCard>
                <controls:SettingsCard Header="恢复默认面板" Description="MetaCubeXD / YACD / Zashboard">
                    <ui:IconActionButton Command="{Binding RestoreWebUiPanelsCommand}" Glyph="&#xE72C;" ToolTipService.ToolTip="恢复默认 WebUI" />
                </controls:SettingsCard>
                <ItemsControl ItemsSource="{Binding WebUiPanels}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WebUiPanelViewModel">
                            <controls:SettingsCard Header="{x:Bind Name}"
                                                   Description="{x:Bind Url}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <ui:IconActionButton Command="{Binding DataContext.OpenWebUiCommand, ElementName=PageRoot}"
                                                         CommandParameter="{x:Bind}"
                                                         Glyph="&#xE8A7;"
                                                         ToolTipService.ToolTip="打开 WebUI" />
                                    <ui:IconActionButton Click="DeleteWebUiPanel_Click"
                                                         Tag="{x:Bind}"
                                                         Glyph="&#xE74D;"
                                                         ToolTipService.ToolTip="删除 WebUI" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="访问控制" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="允许局域网" Description="允许其他设备连接本机代理">
                    <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding AllowLan, Mode=TwoWay}" HorizontalAlignment="Right" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="允许的地址" Description="仅允许这些地址访问，每行一个 CIDR" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <TextBox AcceptsReturn="True" MinHeight="88" HorizontalAlignment="Stretch" Text="{Binding LanAllowedIps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="禁止的地址" Description="拒绝这些地址访问，每行一个 CIDR" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <TextBox AcceptsReturn="True" MinHeight="88" HorizontalAlignment="Stretch" Text="{Binding LanDisallowedIps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="用户认证" Description="每行一个 user:password" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <TextBox AcceptsReturn="True" MinHeight="88" HorizontalAlignment="Stretch" Text="{Binding Authentication, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="免认证地址" Description="这些地址无需认证，每行一个 CIDR" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                    <TextBox AcceptsReturn="True" MinHeight="88" HorizontalAlignment="Stretch" Text="{Binding SkipAuthPrefixes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock Text="基础参数" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="IPv6" Description="启用 IPv6 支持">
                    <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding Ipv6, Mode=TwoWay}" HorizontalAlignment="Right" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="统一延迟" Description="统一计算节点延迟">
                    <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding UnifiedDelay, Mode=TwoWay}" HorizontalAlignment="Right" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="TCP 并发" Description="并发尝试多个目标 IP">
                    <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding TcpConcurrent, Mode=TwoWay}" HorizontalAlignment="Right" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="记住节点选择" Description="重启后保留代理组选择">
                    <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding StoreSelected, Mode=TwoWay}" HorizontalAlignment="Right" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="保留 Fake-IP 映射" Description="重启内核后继续使用现有映射">
                    <ToggleSwitch MinWidth="0" Width="48" OnContent="" OffContent="" IsOn="{Binding StoreFakeIp, Mode=TwoWay}" HorizontalAlignment="Right" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="日志级别" Description="控制内核日志的详细程度">
                    <ComboBox SelectedIndex="{Binding LogLevelIndex, Mode=TwoWay}" MinWidth="136" HorizontalAlignment="Right">
                        <ComboBoxItem Content="静默（silent）" />
                        <ComboBoxItem Content="错误（error）" />
                        <ComboBoxItem Content="警告（warning）" />
                        <ComboBoxItem Content="信息（info）" />
                        <ComboBoxItem Content="调试（debug）" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard Header="进程查找模式" Description="控制连接的进程识别方式">
                    <ComboBox SelectedIndex="{Binding FindProcessIndex, Mode=TwoWay}" MinWidth="136" HorizontalAlignment="Right">
                        <ComboBoxItem Content="关闭（off）" />
                        <ComboBoxItem Content="严格（strict）" />
                        <ComboBoxItem Content="始终（always）" />
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>

            <TextBlock Text="日志维护" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="4">
                <controls:SettingsCard Header="保留天数" Description="程序日志与内核日志">
                    <NumberBox Width="120" HorizontalAlignment="Right" Value="{Binding MaxLogDays, Mode=TwoWay}" Minimum="1" Maximum="365" SpinButtonPlacementMode="Compact" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="单文件大小（MB）" Description="达到限制后自动创建新日志文件">
                    <NumberBox Width="120" HorizontalAlignment="Right" Value="{Binding MaxLogFileSizeMb, Mode=TwoWay}" Minimum="1" Maximum="1024" SpinButtonPlacementMode="Compact" />
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
